generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN MANAGEMENT SALES PURCHASING INVENTORY ANALYST VIEWER }
enum ProductStatus { ACTIVE INACTIVE DISCONTINUED }
enum PurchaseOrderStatus { DRAFT APPROVED SENT CONFIRMED PARTIALLY_RECEIVED RECEIVED CANCELLED }
enum InventoryTransactionType { OPENING_BALANCE PURCHASE_RECEIPT SALE SALES_RETURN PURCHASE_RETURN TRANSFER_IN TRANSFER_OUT ADJUSTMENT_IN ADJUSTMENT_OUT DAMAGED }

model Company {
  id String @id @default(cuid())
  name String
  code String @unique
  currency String @default("USD")
  timezone String @default("Asia/Baghdad")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users User[]
  warehouses Warehouse[]
  products Product[]
  suppliers Supplier[]
  sales Sale[]
  purchaseOrders PurchaseOrder[]
}

model User {
  id String @id @default(cuid())
  companyId String
  name String
  email String @unique
  role UserRole @default(VIEWER)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId])
}

model Warehouse {
  id String @id @default(cuid())
  companyId String
  name String
  code String
  city String?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances InventoryBalance[]
  transactions InventoryTransaction[]
  @@unique([companyId, code])
}

model Brand {
  id String @id @default(cuid())
  name String @unique
  products Product[]
}

model Category {
  id String @id @default(cuid())
  name String
  code String @unique
  products Product[]
}

model Product {
  id String @id @default(cuid())
  companyId String
  brandId String?
  categoryId String?
  name String
  sku String
  status ProductStatus @default(ACTIVE)
  baseCost Decimal @db.Decimal(18,4)
  sellingPrice Decimal @db.Decimal(18,4)
  leadTimeDays Int @default(30)
  minimumOrderQuantity Int @default(1)
  safetyStock Int @default(0)
  reorderPoint Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  brand Brand? @relation(fields: [brandId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  balances InventoryBalance[]
  transactions InventoryTransaction[]
  saleItems SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  forecasts Forecast[]
  @@unique([companyId, sku])
  @@index([companyId, status])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  variantSku String @unique
  color String?
  storage String?
  modelNumber String?
  barcode String?
  active Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model Supplier {
  id String @id @default(cuid())
  companyId String
  name String
  code String
  email String?
  phone String?
  country String?
  currency String @default("USD")
  leadTimeDays Int @default(30)
  active Boolean @default(true)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]
  @@unique([companyId, code])
}

model InventoryBalance {
  id String @id @default(cuid())
  warehouseId String
  productId String
  onHand Int @default(0)
  reserved Int @default(0)
  inTransit Int @default(0)
  updatedAt DateTime @updatedAt
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([warehouseId, productId])
}

model InventoryTransaction {
  id String @id @default(cuid())
  warehouseId String
  productId String
  type InventoryTransactionType
  quantity Int
  unitCost Decimal? @db.Decimal(18,4)
  referenceType String?
  referenceId String?
  transactionAt DateTime @default(now())
  notes String?
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@index([warehouseId, productId, transactionAt])
}

model Sale {
  id String @id @default(cuid())
  companyId String
  invoiceNumber String
  channel String
  saleDate DateTime
  currency String @default("USD")
  subtotal Decimal @db.Decimal(18,4)
  discount Decimal @default(0) @db.Decimal(18,4)
  total Decimal @db.Decimal(18,4)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items SaleItem[]
  @@unique([companyId, invoiceNumber])
  @@index([companyId, saleDate])
}

model SaleItem {
  id String @id @default(cuid())
  saleId String
  productId String
  quantity Int
  unitPrice Decimal @db.Decimal(18,4)
  unitCost Decimal @db.Decimal(18,4)
  discount Decimal @default(0) @db.Decimal(18,4)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@index([productId])
}

model PurchaseOrder {
  id String @id @default(cuid())
  companyId String
  supplierId String
  poNumber String
  status PurchaseOrderStatus @default(DRAFT)
  orderDate DateTime @default(now())
  expectedDelivery DateTime?
  currency String @default("USD")
  totalCost Decimal @db.Decimal(18,4)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id])
  items PurchaseOrderItem[]
  @@unique([companyId, poNumber])
  @@index([companyId, status])
}

model PurchaseOrderItem {
  id String @id @default(cuid())
  purchaseOrderId String
  productId String
  quantity Int
  receivedQuantity Int @default(0)
  unitCost Decimal @db.Decimal(18,4)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model Forecast {
  id String @id @default(cuid())
  productId String
  forecastDate DateTime
  horizonDays Int
  predictedDemand Float
  confidenceLow Float
  confidenceHigh Float
  modelName String
  accuracyScore Float?
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, forecastDate, horizonDays, modelName])
}
